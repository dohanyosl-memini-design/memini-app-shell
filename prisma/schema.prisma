generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  role          String   @default("user")
  active        Boolean  @default(true)
  // Bejelentkezés-találgatás elleni védelem. Serverless-en a memóriában tartott
  // számláló nem működne (több példány), ezért az adatbázisban tartjuk.
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  assignedTasks Task[]
}

model Contact {
  id                String             @id @default(cuid())
  salutation        String?
  firstName         String
  lastName          String
  email             String?
  phone             String?
  status            String             @default("lead")
  notes             String?
  marketingOptOut   Boolean            @default(false) // kampány-etaphoz: leiratkozás (GDPR/UWG)
  companyId         String?
  company           Company?           @relation(fields: [companyId], references: [id])
  deals             Deal[]
  tasks             Task[]
  activities        Activity[]
  invoices          Invoice[]
  quotes            Quote[]
  orders            Order[]
  deliveryNotes     DeliveryNote[]
  memories          MemoryEntry[]
  brainNotes        BrainNote[]
  emailThreads      EmailThread[]
  emailParticipants EmailParticipant[]
  emailDrafts       EmailDraft[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Company {
  id                String             @id @default(cuid())
  name              String
  partnerType       String?
  industry          String?
  website           String?
  phone             String?
  email             String?
  address           String?
  zip               String?
  city              String?
  region            String?
  country           String?            @default("DE")
  vatId             String?
  customerNumber    String?
  classification    String?            @default("D")
  language          String?            @default("DE")
  channel           String?
  notes             String?
  businessHours     Json?
  lastOrderDate     DateTime?
  contacts          Contact[]
  deals             Deal[]
  invoices          Invoice[]
  activities        Activity[]
  quotes            Quote[]
  orders            Order[]
  tasks             Task[]
  deliveryNotes     DeliveryNote[]
  memories          MemoryEntry[]
  brainNotes        BrainNote[]
  emailThreads      EmailThread[]
  emailParticipants EmailParticipant[]
  emailDrafts       EmailDraft[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Deal {
  id          String     @id @default(cuid())
  title       String
  value       Float      @default(0)
  stage       String     @default("outreach_sent")
  probability Int        @default(0)
  closeDate   DateTime?
  notes       String?
  contactId   String?
  contact     Contact?   @relation(fields: [contactId], references: [id])
  companyId   String?
  company     Company?   @relation(fields: [companyId], references: [id])
  tasks       Task[]
  activities  Activity[]
  brainNotes  BrainNote[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// Havi tölcsér-tervszámok (FÁZIS 2) — a get_funnel_stats terv/tény összevetéséhez.
// Runtime-ban szerkeszthető; hiányzó hónapokra a kód a beépített defaultokra esik vissza.
model FunnelTarget {
  yearMonth      String   @id // 'YYYY-MM'
  outreach       Int      @default(0) // kiküldött outreach dealek terve
  followup       Int      @default(0) // follow-up aktivitások terve
  sampleRequests Int      @default(0) // mintakérések terve
  newPartners    Int      @default(0) // új partnerek (won) terve
  reorders       Int      @default(0) // reorderek terve
  volumeEur      Float    @default(0) // rendelési volumen terve EUR-ban
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Célhierarchia (V1): vision → yearly → quarterly → monthly önhivatkozó fában.
// A haladás nem tárolt: metricKey esetén a funnel/CRM-adatokból, egyébként a
// gyerek-célok / hozzákötött feladatok kész-arányából számítódik (lib/goalProgress).
model Goal {
  id            String         @id @default(cuid())
  title         String
  description   String?
  level         String // vision | yearly | quarterly | monthly
  year          Int? // yearly/quarterly/monthly szinten kötelező
  quarter       Int? // 1-4, quarterly szinten
  month         Int? // 1-12, monthly szinten
  status        String         @default("active") // active | achieved | missed | dropped
  strategicArea String? // opcionális stratégiai terület címke
  metricKey     String? // funnel-metrika kulcs (outreach, followup, sampleRequests, newPartners, reorders, volumeEur)
  targetValue   Float? // számszerű célérték a metricKey-hez
  sortOrder     Int            @default(0)
  archivedAt    DateTime?
  parentId      String?
  parent        Goal?          @relation("GoalTree", fields: [parentId], references: [id])
  children      Goal[]         @relation("GoalTree")
  tasks         Task[]
  marketingArcs MarketingArc[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Task {
  id          String      @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      String      @default("pending")
  priority    String      @default("medium")
  taskType    String?
  source      String      @default("human") // human | agent | automation
  focused     Boolean     @default(false) // kézzel a Fókuszba emelve
  waitingFor  String? // waiting státusznál: kire/mire várunk
  followUpAt  DateTime? // waiting státusznál: mikor kell újra ránézni
  goalId      String?
  goal        Goal?       @relation(fields: [goalId], references: [id])
  assigneeId  String?
  assignee    User?       @relation(fields: [assigneeId], references: [id])
  contactId   String?
  contact     Contact?    @relation(fields: [contactId], references: [id])
  dealId      String?
  deal        Deal?       @relation(fields: [dealId], references: [id])
  companyId   String?
  company     Company?    @relation(fields: [companyId], references: [id])
  subtasks    SubTask[]
  events      TaskEvent[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ─── MARKETING (V1) ──────────────────────────────────────────────────────────
// Marketing-ív: a célfával párhuzamos, de dedikált idő-hierarchia
// (vision → yearly → quarterly → monthly). Az alsó szinteken kadencia
// (heti hány tartalom csatornánként) — ebből számítódik a telítettség.
model MarketingArc {
  id            String         @id @default(cuid())
  title         String
  description   String?
  level         String // vision | yearly | quarterly | monthly
  year          Int?
  quarter       Int?
  month         Int?
  status        String         @default("active") // active | achieved | missed | dropped
  strategicArea String?
  cadence       Json? // pl. { "blog": 3, "linkedin": 2 } (heti darab csatornánként)
  goalId        String? // opcionális kötés az éves üzleti célra
  goal          Goal?          @relation(fields: [goalId], references: [id])
  sortOrder     Int            @default(0)
  archivedAt    DateTime?
  parentId      String?
  parent        MarketingArc?  @relation("ArcTree", fields: [parentId], references: [id])
  children      MarketingArc[] @relation("ArcTree")
  themes        ContentTheme[]
  pieces        ContentPiece[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// Téma / "kör": egy arc-node alatti tartalmi koncepció — mondanivaló + vázlat
// (részek). Ebből származnak a konkrét tartalmak (blog → LinkedIn → Insta …).
model ContentTheme {
  id         String         @id @default(cuid())
  title      String
  message    String? // a mondanivaló / core message
  outline    String? // a struktúra / részek (markdown szöveg)
  status     String         @default("planned") // planned | approved | active | done
  startDate  DateTime?
  endDate    DateTime?
  cadence    Json?
  sortOrder  Int            @default(0)
  archivedAt DateTime?
  arcId      String?
  arc        MarketingArc?  @relation(fields: [arcId], references: [id])
  pieces     ContentPiece[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

// Egy konkrét tartalom: egy üzenet három nyelven (német elsődleges), egy
// csatornára. A parentPieceId a csatorna-származtatást köti (blog → LinkedIn).
model ContentPiece {
  id            String         @id @default(cuid())
  title         String
  channel       String // blog | linkedin | facebook | instagram | newsletter | pinterest
  bodyDe        String?        @db.Text // elsődleges (német logika)
  bodyHu        String?        @db.Text
  bodyEn        String?        @db.Text
  slug          String? // weboldal-kész
  seo           Json? // { de: {title, description}, hu: {...}, en: {...} }
  imagePrompt   String?
  imageUrl      String?
  status        String         @default("draft") // draft | ready | scheduled | published | archived
  source        String         @default("human") // human | agent | automation
  focused       Boolean        @default(false) // kézzel a Fókuszba emelve
  scheduledFor  DateTime?
  publishedAt   DateTime?
  themeId       String?
  theme         ContentTheme?  @relation(fields: [themeId], references: [id])
  arcId         String? // ad-hoc: közvetlenül egy arc-hónaphoz tűzve, téma nélkül
  arc           MarketingArc?  @relation(fields: [arcId], references: [id])
  parentPieceId String?
  parentPiece   ContentPiece?  @relation("PieceDerivation", fields: [parentPieceId], references: [id])
  derivedPieces ContentPiece[] @relation("PieceDerivation")
  images        ContentImage[]
  events        ContentEvent[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// Tartalomhoz tartozó kép — feltöltéskor / MCP-ingesztáláskor WebP-be konvertálva
// (sharp) és Vercel Blobban tárolva. Egy piece-nek több képe lehet, egy a borító
// (isPrimary → a piece.imageUrl gyorshivatkozás). Az alt-szöveg nyelvenként
// opcionális (weboldal-SEO).
model ContentImage {
  id        String       @id @default(cuid())
  pieceId   String
  piece     ContentPiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean      @default(false)
  altDe     String?
  altHu     String?
  altEn     String?
  width     Int?
  height    Int?
  bytes     Int?
  source    String       @default("human") // human | agent
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
}

// Append-only tartalom-eseménytörténet (mint a TaskEvent) — ki mit generált /
// szerkesztett és mi volt előtte.
model ContentEvent {
  id        String       @id @default(cuid())
  pieceId   String
  piece     ContentPiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  actor     String
  action    String // created | updated | status_changed | localized | derived | archived
  field     String?
  before    Json?
  after     Json?
  createdAt DateTime     @default(now())
}

// Könnyű, append-only feladat-eseménytörténet: ki (ember/agent/automatizáció)
// mit változtatott és mi volt előtte — az agent-műveletek ellenőrizhetőségéhez.
model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     String // pl. felhasználónév, "agent", "automation"
  action    String // created | updated | status_changed | archived | subtask_promoted ...
  field     String? // melyik mező változott (updated esetén)
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
}

model SubTask {
  id        String    @id @default(cuid())
  title     String
  completed Boolean   @default(false)
  dueDate   DateTime? // opcionális saját határidő — így az előkészítő lépés önállóan a Fókuszba kerül
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model Activity {
  id           String   @id @default(cuid())
  type         String
  subject      String?
  description  String
  activityDate DateTime @default(now())
  duration     Int?
  outcome      String?
  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id])
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  dealId       String?
  deal         Deal?    @relation(fields: [dealId], references: [id])
  createdAt    DateTime @default(now())
}

model Product {
  id                 String              @id @default(cuid())
  name               String
  nameDE             String?
  sku                String              @unique
  description        String?
  material           String?
  productType        String?
  site               String?
  city               String?
  locationCabinet    String?
  locationShelf      String?
  locationBox        String?
  costPrice          Float               @default(0)
  salesPrice         Float               @default(0)
  stock              Int                 @default(0)
  minStock           Int                 @default(10)
  unit               String              @default("db")
  vatRate            Float               @default(19)
  active             Boolean             @default(true)
  imageUrl           String?
  priceListEntryId   String?
  purchaseOrderItems PurchaseOrderItem[]
  movements          StockMovement[]
  invoiceItems       InvoiceItem[]
  quoteItems         QuoteItem[]
  orderItems         OrderItem[]
  deliveryNoteItems  DeliveryNoteItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model StockMovement {
  id        String   @id @default(cuid())
  type      String
  quantity  Int
  note      String?
  supplier  String?
  reference String?
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  date           DateTime      @default(now())
  dueDate        DateTime
  status         String        @default("open")
  notes          String?
  deliveryInfo   String?
  stornoOf       String?
  billingName    String?
  billingAddress String?
  billingZip     String?
  billingCity    String?
  billingCountry String?
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id])
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id])
  items          InvoiceItem[]
  subtotal       Float         @default(0)
  vatAmount      Float         @default(0)
  total          Float         @default(0)
  currency       String        @default("EUR")
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model InvoiceItem {
  id          String   @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float
  vatRate     Float    @default(19)
  total       Float
  isDiscount  Boolean  @default(false)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
}

model Transaction {
  id          String   @id @default(cuid())
  type        String
  amount      Float
  currency    String   @default("EUR")
  date        DateTime
  description String
  category    String?
  reference   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Quote {
  id         String      @id @default(cuid())
  number     String      @unique
  date       DateTime    @default(now())
  validUntil DateTime?
  status     String      @default("draft")
  notes      String?
  contactId  String?
  contact    Contact?    @relation(fields: [contactId], references: [id])
  companyId  String?
  company    Company?    @relation(fields: [companyId], references: [id])
  // Címzett — a számlához hasonlóan felülírható, ha eltér a cég törzsadatától.
  billingName    String?
  billingAddress String?
  billingZip     String?
  billingCity    String?
  billingCountry String?
  items      QuoteItem[]
  subtotal   Float       @default(0)
  vatAmount  Float       @default(0)
  total      Float       @default(0)
  currency   String      @default("EUR")
  // Mikor ment ki a partnernek. A státusz önmagában kézzel is állítható, ez
  // viszont csak a tényleges kiküldéskor íródik — erre épül a lejárat-figyelés.
  sentAt     DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model QuoteItem {
  id          String   @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float
  vatRate     Float    @default(19)
  total       Float
  // Kedvezmény-sor (Rabatt): negatív egységárral, a számlatételek mintájára.
  isDiscount  Boolean  @default(false)
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique
  date            DateTime    @default(now())
  status          String      @default("pending")
  notes           String?
  internalNotes   String?
  customerRef     String?
  deliveryAddress String?
  contactId       String?
  contact         Contact?    @relation(fields: [contactId], references: [id])
  companyId       String?
  company         Company?    @relation(fields: [companyId], references: [id])
  quoteId         String?
  items           OrderItem[]
  subtotal        Float       @default(0)
  vatAmount       Float       @default(0)
  total           Float       @default(0)
  currency        String      @default("EUR")
  deliveryDate    DateTime?
  shippingMethod  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id          String   @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float
  vatRate     Float    @default(19)
  total       Float
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  vendor      String
  description String
  amount      Float
  vatAmount   Float    @default(0)
  totalAmount Float    @default(0)
  currency    String   @default("EUR")
  category    String?
  receiptUrl  String?
  reference   String?
  status      String   @default("pending")
  notes       String?
  eurAmount   Float?
  eurRate     Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#6B7280")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model RecurringExpense {
  id        String   @id @default(cuid())
  name      String
  vendor    String?
  amount    Float
  currency  String   @default("EUR")
  category  String?
  frequency String   @default("monthly")
  startDate DateTime
  nextDue   DateTime
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeliveryNote {
  id             String             @id @default(cuid())
  number         String             @unique
  date           DateTime           @default(now())
  deliveryInfo   String?
  status         String             @default("draft")
  notes          String?
  billingName    String?
  billingAddress String?
  billingZip     String?
  billingCity    String?
  billingCountry String?
  contactId      String?
  contact        Contact?           @relation(fields: [contactId], references: [id])
  companyId      String?
  company        Company?           @relation(fields: [companyId], references: [id])
  items          DeliveryNoteItem[]
  subtotal       Float              @default(0)
  vatAmount      Float              @default(0)
  total          Float              @default(0)
  currency       String             @default("EUR")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model DeliveryNoteItem {
  id             String       @id @default(cuid())
  description    String
  quantity       Float
  unitPrice      Float
  vatRate        Float        @default(19)
  total          Float
  isDiscount     Boolean      @default(false)
  deliveryNoteId String
  deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id])
}

model Carrier {
  id         String    @id @default(cuid())
  code       String
  name       String
  nameDE     String?
  group      String?
  sortOrder  Int       @default(0)
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model PriceListEntry {
  id        String   @id @default(cuid())
  name      String
  hordozo   String?
  costPrice Float    @default(0)
  basePrice Float    @default(0)
  tiers     Json     @default("[]")
  notes     String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArthurReport {
  id        String   @id @default(cuid())
  type      String
  title     String
  summary   String   @db.Text
  drafts    Json     @default("[]")
  createdAt DateTime @default(now())
}

// Memini Brain — a nap rövid távú memóriája. Egy nap = egy rekord, amihez
// Arthur mind a négy napi futása HOZZÁÍR (nem felülír): a 12:00/16:00-s
// állapotmentések a lastSavedAt vízjel alapján csak az azóta történteket
// dolgozzák fel, a 20:30-as futás pedig lezárja a napot.
//
// Ami tartós tudás, azt a záró futás átemeli a hosszú távú memóriába
// (MemoryEntry / BrainNote) — a napló maga megmarad a nap krónikájának.
model DailyJournal {
  id           String    @id @default(cuid())
  date         DateTime  @unique @db.Date // a helyi (Europe/Budapest) nap, amiről szól
  narrative    String?   @db.Text // a nap krónikája, futásonként hozzáfűzve
  emailDigest  Json      @default("[]") // [{ from, subject, gist, action, companyId }] — levélszöveg NEM
  emailSource  String? // agent | crm — a levelek az ügynök postafiókjából vagy a CRM-ből jöttek-e
  priorities   Json      @default("[]") // a következő nap fő fókuszai
  facts        Json      @default("{}") // determinisztikus ténypillanatkép (kódból, nem AI-tól)
  checkpoints  Json      @default("[]") // [{ at, label, note }] — a napközi mentések nyoma
  lastSavedAt  DateTime? // vízjel: eddig dolgozta fel a napot
  closedAt     DateTime? // a záró futás időpontja
  editedByUser Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([date])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  city           String?
  zip            String?
  country        String?         @default("DE")
  website        String?
  vatId          String?
  notes          String?
  active         Boolean         @default(true)
  carriers       Carrier[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  number     String              @unique
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  status     String              @default("draft")
  notes      String?
  orderedAt  DateTime?
  items      PurchaseOrderItem[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Float         @default(0)
  note            String?
}

model KpiTarget {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Float
  updatedAt DateTime @updatedAt
}

model KpiSnapshot {
  id        String   @id @default(cuid())
  month     String
  data      Json
  createdAt DateTime @default(now())

  @@unique([month])
}

model MemoryEntryType {
  id        String        @id @default(cuid())
  label     String
  icon      String
  color     String
  isSystem  Boolean       @default(false)
  order     Int           @default(0)
  entries   MemoryEntry[]
  createdAt DateTime      @default(now())
}

model MemoryEntry {
  id        String          @id @default(cuid())
  companyId String?
  company   Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact?        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  typeId    String
  type      MemoryEntryType @relation(fields: [typeId], references: [id])
  content   String
  date      DateTime?
  source    String          @default("user")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// Memini Brain — a cég hosszú távú tudása: döntések (és az INDOKUK), tanulságok,
// ötletek, elvarratlan szálak. Egy tábla, `kind` megkülönböztetővel: a négy típus
// mezőinek nagy része közös, a típusspecifikus rész a `details` JSON-ban van
// (a sémát az MCP tool-ok zod-validációja adja típusonként).
model BrainNote {
  id           String    @id @default(cuid())
  kind         String // decision | learning | idea | open_loop
  title        String
  content      String    @db.Text
  details      Json      @default("{}")
  // decision:  { reason, alternatives, expectedResult, actualResult, participants }
  // learning:  { reusableRule, worked, didntWork }
  // idea:      { businessValue, risk, nextStep, origin }
  // open_loop: { nextAction, blocker, owner }
  status       String    @default("open")
  importance   Int       @default(2) // 1 = alacsony, 2 = normál, 3 = magas

  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId    String?
  contact      Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId       String?
  deal         Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  orderId      String?
  taskId       String?

  source       String    @default("mcp") // user | mcp | journal
  confidence   String    @default("certain") // certain | assumed — az AI feltételezését jelöli
  editedByUser Boolean   @default(false)

  eventDate    DateTime? // mikor történt (nem mikor rögzítettük)
  dueDate      DateTime? // nyitott ügy határideje / döntés felülvizsgálata
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([kind, status])
  @@index([companyId])
  @@index([eventDate])
  @@index([dueDate])
}

model TemplateType {
  id        String         @id @default(cuid())
  label     String
  icon      String
  isSystem  Boolean        @default(false)
  order     Int            @default(0)
  templates CommTemplate[]
  createdAt DateTime       @default(now())
}

model CommTemplate {
  id          String       @id @default(cuid())
  name        String
  typeId      String
  type        TemplateType @relation(fields: [typeId], references: [id])
  subject     String?
  bodyHu      String
  description String?
  isActive    Boolean      @default(true)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ─── LEVELEZŐRENDSZER (Etap 1) ───────────────────────────────────────────────
// A postafiók marad a forrásrendszer (IMAP); ez a réteg kereshető indexet,
// partner-hozzárendelést és a kimenő jóváhagyási láncot adja. A modell a
// memini-mail-bridge bevált táblatervének Prisma-portja, azzal a KÜLÖNBSÉGGEL,
// hogy a cég/kontakt hivatkozás mostantól a CRM valódi Company/Contact
// tábláira mutat — egyetlen igazság-forrás, nem külön mini-CRM.

// Egy figyelt postafiók (pl. hello@memini-design.de) + IMAP-beállítás.
model EmailAccount {
  id           String             @id @default(cuid())
  address      String             @unique
  label        String?
  inboxFolder  String             @default("INBOX")
  sentFolder   String?
  active       Boolean            @default(true)
  emails       Email[]
  folderStates EmailFolderState[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

// Inkrementális szinkron állapota mappánként: honnan folytassa a következő
// futás (UID + UIDVALIDITY), hogy ne olvassa újra az egész postafiókot.
model EmailFolderState {
  id           String       @id @default(cuid())
  accountId    String
  account      EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  folderName   String
  uidValidity  BigInt       @default(0)
  // Két kurzor: az ÚJ levelek felfelé (lastSeenUid a vízszint), a régi
  // history pedig LEFELÉ töltődik (backfillUid). Így a friss levél azonnal
  // bejön, az archívum meg a háttérben szivárog vissza az időben.
  lastSeenUid  BigInt       @default(0)
  backfillUid  BigInt? // meddig jutottunk visszafelé; null = még nem indult, 0 = kész
  lastSyncedAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([accountId, folderName])
}

// Levélszál — a párosítás Message-ID/References, majd tárgy+résztvevő+idő
// heurisztikával történik (lib/email/matching). A válaszstátusz adja a
// "válaszra vár" listát, ami a proaktív munkás egyik fő jelzése.
model EmailThread {
  id                String       @id @default(cuid())
  subject           String
  normalizedSubject String
  firstMessageAt    DateTime
  lastMessageAt     DateTime
  messageCount      Int          @default(0)
  replyStatus       String       @default("unanswered") // unanswered | answered | no_reply_needed | reply_later | closed
  category          String       @default("conversation") // conversation | automated | spam (lib/email/classify)
  contactId         String?
  contact           Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId         String?
  company           Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  emails            Email[]
  drafts            EmailDraft[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([lastMessageAt])
  @@index([companyId])
  @@index([contactId])
  @@index([replyStatus])
  @@index([category])
}

model Email {
  id                String             @id @default(cuid())
  accountId         String
  account           EmailAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  threadId          String
  thread            EmailThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  messageId         String?
  inReplyTo         String?
  references        String[]           @default([])
  fallbackHash      String // dedup, ha nincs Message-ID
  subject           String
  normalizedSubject String
  textBody          String             @db.Text
  htmlBody          String?            @db.Text
  snippet           String             @default("")
  direction         String // inbound | outbound
  category          String             @default("conversation") // conversation | automated | spam
  folderName        String
  imapUid           BigInt
  uidValidity       BigInt
  sentAt            DateTime
  receivedAt        DateTime
  processingStatus  String             @default("processed")
  rawHeaders        Json               @default("{}")
  participants      EmailParticipant[]
  attachments       EmailAttachment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([accountId, folderName, uidValidity, imapUid])
  @@index([threadId, sentAt])
  @@index([messageId])
  @@index([fallbackHash])
  @@index([receivedAt])
}

model EmailParticipant {
  id           String   @id @default(cuid())
  emailId      String
  email        Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  type         String // from | to | cc | bcc
  emailAddress String
  displayName  String?
  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([emailId])
  @@index([emailAddress])
  @@index([contactId])
  @@index([companyId])
}

model EmailAttachment {
  id          String   @id @default(cuid())
  emailId     String
  email       Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  filename    String
  contentType String
  sizeBytes   BigInt   @default(0)
  blobUrl     String? // Vercel Blob (a CRM már ezt használja képekhez)
  contentId   String?
  isInline    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([emailId])
}

// EGYETLEN kimenő csővezeték: kézzel írt válasz, agent-tervezet és később a
// kampánylevél is ide kerül — a source mező különbözteti meg. Az élet-ciklus
// draft → approved → sent adja a jóváhagyási kaput (a "Küldd" gomb).
model EmailDraft {
  id          String       @id @default(cuid())
  threadId    String?
  thread      EmailThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  contactId   String?
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId   String?
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  toAddresses Json         @default("[]")
  ccAddresses Json         @default("[]")
  subject     String
  bodyText    String       @db.Text
  bodyHtml    String?      @db.Text
  status      String       @default("draft") // draft | approved | sent | discarded | failed
  source      String       @default("human") // human | agent | campaign
  createdBy   String?
  approvedBy  String?
  sentAt      DateTime?
  sendError   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([threadId])
  @@index([companyId])
}
