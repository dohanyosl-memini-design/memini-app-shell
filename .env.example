# Adatbázis
# Lokálisan: SQLite (csak dev-hez)
# DATABASE_URL="file:./dev.db"

# Productionban: PostgreSQL (Railway vagy Neon)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth – kötelező production-ban!
# Generálás: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="https://your-app.vercel.app"

# ─── Levél-szinkron (scripts/email-sync.ts, a cPanel cron futtatja) ───────────
# EZEK A TITKOK A cPanel ENV-BEN ÉLNEK, nem a repóban / nem a Vercelen.
IMAP_HOST=""
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=""
IMAP_AUTH_MODE=password            # password | oauth2
IMAP_PASSWORD=""                   # jelszavas módnál
# OAuth2 módnál (Gmail/Microsoft) a jelszó helyett:
OAUTH2_TOKEN_URL=""
OAUTH2_CLIENT_ID=""
OAUTH2_CLIENT_SECRET=""
OAUTH2_REFRESH_TOKEN=""
OAUTH2_SCOPE=""
# Mappák és saját címek (a bejövő/kimenő irány felismeréséhez)
IMAP_INBOX_FOLDER=INBOX
IMAP_SENT_FOLDER=""
IMAP_EXTRA_FOLDERS=""              # vesszővel elválasztva
MEMINI_EMAIL_ADDRESSES=""         # saját címek, vesszővel
MEMINI_EMAIL_DOMAINS=""           # saját domainek, vesszővel
IMAP_INITIAL_SYNC_LIMIT=500       # kezdeti behúzás felső korlátja (levél/mappa)
IMAP_MAX_ATTACHMENT_BYTES=26214400

# ─── Biztonság / hozzáférés ──────────────────────────────────────────────────
# NextAuth session-titkosítás — KÖTELEZŐ. Generálás: openssl rand -base64 32
NEXTAUTH_SECRET=""

# MCP hozzáférés kulcsa. Ha ÜRES/hiányzik, az /api/mcp végpont TILT (zárva bukás).
# Ezt add meg a connector URL-jében is (?key=... vagy x-api-key fejléc).
MCP_SECRET=""

# Cron-végpontok (Vercel Cron) hitelesítése. Bearer-tokenként küldve.
CRON_SECRET=""

# Teljes mentés / visszaállítás PIN-kódja (/api/backup, /api/admin/restore).
BACKUP_PIN=""

# Egyszeri felhasználó-inicializálás (/api/setup). A setup CSAK ezekkel fut,
# és csak ha még nincs felhasználó. A jelszó soha nem kerül a forráskódba.
SETUP_SECRET=""
SETUP_ADMIN_EMAIL=""
SETUP_ADMIN_PASSWORD=""
SETUP_ADMIN_NAME=""

# ─── connectors.hu (külső szolgáltatás-szinkron, pl. Billingo) ───────────────
# A connectors CLI (scripts/connectors-setup.sh telepíti) ezzel a tokennel
# hitelesít a connectors.hu felé. A tokent a connectors.hu vezérlőpultján kell
# generálni: https://connectors.hu/dashboard/api-keys — formátuma cnk_...
# A TITKOT NE ide, hanem a futtató környezet env-jébe tedd (soha nem a repóba).
# Lásd: docs/connectors-hu.md
CONNECTORS_HU_TOKEN=""
